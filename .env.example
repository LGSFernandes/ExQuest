# ExQuest — copie para `.env` e preencha. NUNCA versione o `.env`.
# Passo a passo de cada serviço: docs/TUTORIAL_SERVICOS_EXTERNOS.md

# ── Aplicação ─────────────────────────────────────────
# development | production
APP_ENV=development
# URL pública do site (usada em links de e-mail, retorno de pagamento e SEO). Em produção: https://seu-dominio
BASE_URL=http://127.0.0.1:5000
# OBRIGATÓRIA em produção (>= 32 caracteres). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Número de proxies reversos confiáveis na frente do app (Nginx/Caddy/Cloudflare Tunnel = 1). 0 = nenhum.
TRUSTED_PROXIES=0
LOG_LEVEL=INFO

# ── Banco de dados ────────────────────────────────────
# Vazio = SQLite em instance/database.db. PostgreSQL: postgresql://usuario:senha@host:5432/exquest
DATABASE_URL=
SQLITE_WAL=true

# ── Limitador de requisições ──────────────────────────
# memory:// serve para 1 processo. Com vários workers use Redis: redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://

# E-mail de contato exibido nos Termos e na Política de Privacidade (direitos do titular, reembolsos). Obrigatório em produção.
CONTATO_EMAIL=

# ── E-mail (recuperação de senha) ─────────────────────
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# ── Login com Google (opcional) ───────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Pagamentos (opcionais; cada recurso informa "indisponível" se ausente) ──
# Mercado Pago (pagamento único: pacotes de moedas e Premium pré-pago)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# true = usa credenciais de teste do Mercado Pago
MP_SANDBOX=false
# Stripe (pagamento único: Premium pré-pago e moedas; não há cobrança recorrente)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Desempenho, filas e cache ─────────────────────────
# Redis é opcional: sem ele, cache e contadores ficam na memória de cada processo (ok para 1 instância).
# Com várias instâncias use o MESMO Redis aqui e em RATELIMIT_STORAGE_URI. Docker: `--profile redis` e redis://redis:6379/0
REDIS_URL=
CACHE_PREFIXO=exq
# eager = e-mails são enviados na própria requisição. queue = vão para a fila e o processo `flask jobs-worker` envia
# (o docker-compose.yml já sobe o worker e usa queue).
JOBS_MODE=eager
# true = a rotina periódica roda dentro das requisições. Com o serviço `tarefas` (compose) use false.
MANUTENCAO_INLINE=true
# CDN opcional para /static (ex.: https://cdn.exemplo.com). Vazio = mesmo domínio. Ver docs/GUIA_DE_INSTALACAO_E_DESENVOLVIMENTO.md
CDN_URL=
COMPRESS_HTML=true
# Pool de conexões (ignorado no SQLite; vale para PostgreSQL). Total de conexões = instâncias x workers x (pool + overflow).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=15000
# Tempo máximo das chamadas a serviços externos (Mercado Pago, Stripe, Google, SMTP), em segundos
HTTP_CONNECT_TIMEOUT=3.05
HTTP_READ_TIMEOUT=10
SMTP_TIMEOUT=10
# Observabilidade
SLOW_REQUEST_MS=800
RUM_ENABLED=true
RUM_SAMPLE=1.0
RUM_RETENCAO_DIAS=30
# OpenTelemetry (opcional): pip install -r requirements-otel.txt e defina o endpoint OTLP do seu coletor
OTEL_ENABLED=false
OTEL_SERVICE_NAME=exquest
OTEL_EXPORTER_OTLP_ENDPOINT=
# Docker (perfil postgres): senha do banco; DATABASE_URL=postgresql+psycopg://exquest:SENHA@postgres:5432/exquest
POSTGRES_PASSWORD=
# Docker: número de processos/threads do gunicorn por instância
WEB_WORKERS=2
WEB_THREADS=4

# ── Outros ────────────────────────────────────────────
# Diretório dos uploads (vazio = app/static/data). Em várias instâncias deve ser um volume COMPARTILHADO.
UPLOAD_ROOT=
# Custo do bcrypt (12 é o padrão; só aumente se o servidor aguentar)
BCRYPT_LOG_ROUNDS=12
# true = logs em JSON (uma linha por evento), melhores para agregadores
LOG_JSON=false
