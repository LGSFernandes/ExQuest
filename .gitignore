# ============================================================
# ExQuest — Git ignore
# Versão preparada para preservar segredos, dados locais e uploads
# sem excluir código, migrations, documentação ou assets necessários.
# ============================================================

# ----------------------------
# Segredos e configurações locais
# ----------------------------
.env
.env.*
!.env.example
!.env.*.example

# Diretórios/arquivos de credenciais locais
/secrets/
**/secrets/
**/credentials*.json
**/client_secret*.json
**/service-account*.json
**/*_private_key*

# Chaves e certificados privados (não ignorar certificados públicos
# versionados deliberadamente sem antes revisar o caso)
*.pem
*.key
*.p12
*.pfx
*.jks

# ----------------------------
# Banco de dados e dados locais
# ----------------------------
/instance/
*.db
*.sqlite
*.sqlite3
*.sqlite3-*
*.db-*
*.sqlite-*

# Backups locais de bancos e arquivos
*.bak
*.backup
*.dump
*.sql.gz
*.sqlite.bak

# ----------------------------
# Python
# ----------------------------
__pycache__/
*.py[cod]
*$py.class
.Python

# Ambientes virtuais
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Empacotamento e builds
build/
dist/
downloads/
*.egg
*.egg-info/
.installed.cfg
MANIFEST
wheels/

# ----------------------------
# Testes, cobertura e ferramentas
# ----------------------------
.pytest_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
.cache/
.webassets-cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
.hatch/
node_modules/
playwright-report/
test-results/

# ----------------------------
# Logs, temporários e runtime
# ----------------------------
*.log
logs/
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo
*~

# ----------------------------
# Uploads e arquivos gerados em runtime
# Por padrão, tudo dentro de app/static/data/ fica fora do Git.
# Exceções: .gitkeep para manter diretórios e badges oficiais do produto.
# Os três PNGs Premium abaixo são referenciados por perfil.html.
# Novos assets oficiais devem ficar preferencialmente em app/static/img/
# ou app/static/assets/; caso precisem ficar aqui, adicione uma exceção
# explícita abaixo após revisar que não são uploads de usuários.
# ----------------------------
/app/static/data/*
!/app/static/data/.gitkeep
!/app/static/data/*/
/app/static/data/*/*
!/app/static/data/*/.gitkeep
!/app/static/data/badges/premium_advan.png
!/app/static/data/badges/premium_basic.png
!/app/static/data/badges/premium_inter.png

# ----------------------------
# Sistema operacional
# ----------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini

# ----------------------------
# IDEs e editores
# ----------------------------
.idea/
.vscode/
.cursorindexingignore
.spyderproject
.spyproject
.ropeproject

# Jupyter
.ipynb_checkpoints/
profile_default/
ipython_config.py

# ----------------------------
# Observações:
# - Mantenha migrations/, requirements.txt, LICENSE e docs/ versionados.
# - Mantenha app/static/vendor/katex/: o projeto usa a cópia local do KaTeX.
# - Mantenha app/static/img/ e app/static/data/badges/ se forem assets oficiais.
# - Não ignore imagens por extensão globalmente; isso esconderia assets do produto.
# ============================================================

app_secrets.py