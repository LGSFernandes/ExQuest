# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Segredos e configuração local (NUNCA versionar)
.env
.env.*
!.env.example

# Banco de dados e backups locais
*.db
*.db-wal
*.db-shm
*.sqlite3
instance/*
!instance/.gitkeep

# Uploads de usuários (avatares, banners, imagens de questões/chat): dados, não código.
# Em produção devem ficar em volume persistente; veja docs/GUIA_DE_INSTALACAO_E_DESENVOLVIMENTO.md
app/static/data/*
!app/static/data/.gitkeep

# Ativos oficiais do produto (ícones, selos, imagens de marca) ficam em app/static/assets/ e SÃO versionados.
# Bibliotecas de terceiros em app/static/vendor/ (KaTeX) também são versionadas, com licença.

# Testes / cobertura / ferramentas
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
test-results/
playwright-report/

# Sistema / editores
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
